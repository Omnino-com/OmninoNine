{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "Node16",
		"moduleResolution": "Node16",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules/**", "src/__tests__/**"]
}
